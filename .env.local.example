ANTHROPIC_API_KEY=sk-ant-...

# Resend — for the /api/contact form.
# Sign up at resend.com (free tier covers 3K emails/mo, 100/day).
RESEND_API_KEY=re_...
# Optional overrides. Defaults are sane:
# CONTACT_TO=byron@mcfearless.dev
# Once mcfearless.dev is verified in Resend, you can switch FROM to a
# branded address like "McFearless Labs <noreply@mcfearless.dev>".
# Until then, leave it on the resend.dev sandbox sender.
# CONTACT_FROM=McFearless Labs <onboarding@resend.dev>
